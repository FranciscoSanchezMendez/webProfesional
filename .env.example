# Copia a .env y ajusta. Nunca subas .env a Git.
# Valores solo para desarrollo local; staging/producción usan secretos propios.

POSTGRES_USER=personalprofile
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=personalprofile
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=4200

# Orígenes permitidos por CORS (separados por comas).
CORS_ORIGINS=http://localhost:4200

# Hosts aceptados por el SSR de Angular (protección anti-SSRF, separados por comas).
NG_ALLOWED_HOSTS=localhost,127.0.0.1
